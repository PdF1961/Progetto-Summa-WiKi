rce: Essenza e attualità del tomismo#Structure":[57,66],"#Source: Essenza e attualità del tomismo#Structure#{1}":[59,59],"#Source: Essenza e attualità del tomismo#Structure#{2}":[60,60],"#Source: Essenza e attualità del tomismo#Structure#{3}":[61,61],"#Source: Essenza e attualità del tomismo#Structure#{4}":[62,62],"#Source: Essenza e attualità del tomismo#Structure#{5}":[63,63],"#Source: Essenza e attualità del tomismo#Structure#{6}":[64,64],"#Source: Essenza e attualità del tomismo#Structure#{7}":[65,66],"#Source: Essenza e attualità del tomismo#Raw File":[67,70],"#Source: Essenza e attualità del tomismo#Raw File#{1}":[69,70]},"outlinks":[{"title":"Réginald Garrigou-Lagrange","target":"Réginald Garrigou-Lagrange","line":13},{"title":"San Tommaso d'Aquino","target":"San Tommaso d'Aquino","line":14},{"title":"Tomismo","target":"Tomismo","line":15},{"title":"Dottrina di Atto e Potenza","target":"Dottrina di Atto e Potenza","line":16},{"title":"XXIV Tesi Tomiste","target":"XXIV Tesi Tomiste","line":17},{"title":"Réginald Garrigou-Lagrange","target":"Réginald Garrigou-Lagrange","line":51},{"title":"San Tommaso d'Aquino","target":"San Tommaso d'Aquino","line":52},{"title":"Tomismo","target":"Tomismo","line":53},{"title":"Dottrina di Atto e Potenza","target":"Dottrina di Atto e Potenza","line":54},{"title":"XXIV Tesi Tomiste","target":"XXIV Tesi Tomiste","line":55}],"metadata":{"type":"source","title":"Essenza e attualità del tomismo","address":"c-000017","created":"2026-07-25","updated":"2026-07-25","tags":["#tomismo","#source","#book"],"status":"mature","related":["[[Réginald Garrigou-Lagrange]]","[[San Tommaso d'Aquino]]","[[Tomismo]]","[[Dottrina di Atto e Potenza]]","[[XXIV Tesi Tomiste]]"],"source_type":"book","author":"Réginald Garrigou-Lagrange","date_published":"2012","url":"","confidence":"high","key_claims":["La dottrina di san Tommaso resta sempre attuale perché conserva verità immutabili contro il relativismo moderno.","La distinzione reale tra potenza e atto è il principio metafisico che permette di conciliare il principio di non-contraddizione col divenire e la molteplicità degli esseri.","Negare la distinzione reale tra essenza creata ed esistenza rende insolubili gli argomenti di Parmenide/Spinoza contro la pluralità degli esseri e indebolisce le prove dell'esistenza di Dio."],"raw_file":".raw/R. Garrigou-Lagrange - Essenza e attualità del Tomismo.epub"},"task_lines":[],"tasks":{},"codeblock_ranges":[]},"smart_blocks:Wiki/sources/essenza-e-attualita-del-tomismo.md#---frontmatter---": {"path":null,"last_embed":{"hash":"dv6z30","at":1785014066008},"embeddings":{"TaylorAI/bge-micro-v2":{"vec":[-0.07410967,0.01678255,0.018141,0.03024778,-0.02379187,-0.00630555,-0.06381723,0.0254982,-0.03952352,0.00845872,-0.03923025,-0.05563498,0.00292804,0.04880263,0.06322829,0.01721829,0.00566355,0.01975884,-0.02463898,-0.02279316,0.12425301,-0.02127371,0.04177523,-0.03193454,0.06028375,0.0138999,-0.00773675,-0.02334085,-0.03188245,-0.1872859,-0.04560154,0.03554337,-0.02727102,-0.03202836,0.01682628,-0.03692086,-0.02409653,0.00664708,-0.03189926,0.03877588,0.03211403,0.07595654,-0.0381062,-0.00829884,-0.02681732,-0.01280324,-0.03087405,0.028897,-0.064256,-0.02689814,-0.07469489,0.08155296,-0.01530872,0.00365012,-0.00281447,0.06773116,0.01342357,0.0609288,0.04502122,0.04699637,0.08942166,0.05327765,-0.27054244,0.04363571,0.05148631,0.02605948,-0.01400566,-0.01049427,-0.01056952,-0.02735431,-0.04334873,-0.00915188,0.0563901,0.03097001,0.05813154,-0.00181936,0.0002734,-0.05094208,-0.05361611,-0.02601135,0.05886098,0.01585962,0.00093829,0.00348851,-0.01636863,0.00753704,0.02342347,0.04092291,0.00952518,-0.02316572,-0.02761297,-0.02194438,0.11458164,0.08741293,0.00447023,-0.02016844,-0.04143055,0.06319751,-0.01804345,0.07776477,-0.05309268,0.01704628,0.02139475,0.00437661,-0.00109924,0.00777717,0.05959378,-0.09712292,0.00117996,0.05879557,-0.04202793,0.00565181,0.03284061,-0.07545716,0.05967277,-0.0213623,0.05837792,-0.02028167,0.01144702,