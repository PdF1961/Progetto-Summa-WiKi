ficance for this vault#{1}":[47,48],"#Source: Somma Teologica — structural entry#Flagged for follow-up deep ingest":[49,52],"#Source: Somma Teologica — structural entry#Flagged for follow-up deep ingest#{1}":[51,52],"#Source: Somma Teologica — structural entry#Raw File":[53,56],"#Source: Somma Teologica — structural entry#Raw File#{1}":[55,56]},"outlinks":[{"title":"San Tommaso d'Aquino","target":"San Tommaso d'Aquino","line":14},{"title":"Tomismo","target":"Tomismo","line":15},{"title":"opuscoli-tommaso","target":"opuscoli-tommaso","line":35},{"title":"sul-male-de-malo","target":"sul-male-de-malo","line":35},{"title":"le-thomisme-gilson","target":"le-thomisme-gilson","line":42},{"title":"god-philosophy-universities","target":"god-philosophy-universities","line":47},{"title":"la-sintesi-tomistica","target":"la-sintesi-tomistica","line":47},{"title":"le-thomisme-gilson","target":"le-thomisme-gilson","line":47},{"title":"mondin-dizionario-tommaso","target":"mondin-dizionario-tommaso","line":47},{"title":"god-philosophy-universities","target":"god-philosophy-universities","line":51},{"title":"la-sintesi-tomistica","target":"la-sintesi-tomistica","line":51},{"title":"la-sintesi-tomistica","target":"la-sintesi-tomistica","line":51},{"title":"la-sintesi-tomistica","target":"la-sintesi-tomistica","line":51}],"metadata":{"type":"source","title":"Somma Teologica — bibliographic/structural entry","address":"c-000038","created":"2026-07-25","updated":"2026-07-25","tags":["#tomismo","#source","#primary-text","#structural-ingest"],"status":"seed","related":["[[San Tommaso d'Aquino]]","[[Tomismo]]"],"source_type":"book","author":"San Tommaso d'Aquino","date_published":"1265/66–1273 (unfinished at Aquinas's death, 7 March 1274); this Italian edition trans. P. Tito S. Centi O.P., online revision P. Angelo Zelio Belloni O.P., 2009","url":"","confidence":"high","key_claims":["This is a structural/bibliographic ingest, not a content read: the file is 5,318 pages (the complete Summa in one PDF), far beyond what can be read in a single ingest pass — this entry records verified structure only, extracted directly from the file's own master index (pp. 1-35), for use as a navigation aid in future targeted deep-ingests.","The verified structure: Prima Pars (I, ~119 qq.), Prima Secundae (I-II, 114 qq., ending at q.114 'Il merito'), Secunda Secundae (II-II, 189 qq., ending at q.189 'L'entrata in religione'), Tertia Pars (III, 90 qq., ending at q.90 'Le parti della penitenza in generale' — confirming Aquinas left the treatise on Penance unfinished at his death), and the Supplementum (compiled posthumously by Reginald of Piperno from Aquinas's earlier Scriptum super Sententiis, per Gilson's bibliography in le-thomisme-gilson)."],"raw_file":".raw/S. Tommaso d'Aquino - Somma Teologica.pdf"},"task_lines":[],"tasks":{},"codeblock_ranges":[]},"smart_blocks:Wiki/sources/somma-teologica-struttura.md#---frontmatter---": {"path":null,"last_embed":{"hash":"u8772n","at":1785014073136},"embeddings":{"TaylorAI/bge-micro-v2":{"vec":[-0.04033093,-0.01248508,0.06424593,-0.01020413,-0.03093313,-0.00044637,-0.08151399,0.02026881,0.0030918,0.00535601,-0.01124513,-0.06473248,0.00756873,0.04856978,0.0237253,-0.0336034,0.00201778,0.03735337,0.01376737,0.03101433,0.12938127,0.01681729,0.01936444,0.00131134,0.05433334,0.04003947,0.01064802,0.00079978,-0.02289406,-0.20956889,-0.0390714,0.03009553,-0.00010403,-0.01651168,-0.0168744,-0.00594881,-0.04795371,-0.00558779,0.02470098,0.03279731,0.03249639,0.10036118,-0.01944939,-0.00510378,-0.02787631,0.00596061,-0.03844882,0.0251943,-0.0116946,-0.02127104,-0.06935528,0.05574938,0.02676736,0.07339925,-0.04405538,0.05268272,0.04150358,0.04060225,-0.00208722,0.01589321,0.04599232,0.09078467,-0.2266387,0.06160773,0.02973022,0.02752652,-0.07867888,0.05194668,0.01471667,-0.00725753,-0.03549101,-0.00747402,0.04423191,0.00884618,0.04553614,-0.07388406,0.03983053,-0.04645132,-0.03350408,0.01238697,0.01746954,0.02772558,0.0028003,0.01608997,-0.04