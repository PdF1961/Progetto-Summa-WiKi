rget":"Tomismo","line":15},{"title":"opuscoli-tommaso","target":"opuscoli-tommaso","line":35},{"title":"sul-male-de-malo","target":"sul-male-de-malo","line":35},{"title":"le-thomisme-gilson","target":"le-thomisme-gilson","line":42},{"title":"god-philosophy-universities","target":"god-philosophy-universities","line":47},{"title":"la-sintesi-tomistica","target":"la-sintesi-tomistica","line":47},{"title":"le-thomisme-gilson","target":"le-thomisme-gilson","line":47},{"title":"mondin-dizionario-tommaso","target":"mondin-dizionario-tommaso","line":47},{"title":"god-philosophy-universities","target":"god-philosophy-universities","line":51},{"title":"la-sintesi-tomistica","target":"la-sintesi-tomistica","line":51},{"title":"la-sintesi-tomistica","target":"la-sintesi-tomistica","line":51},{"title":"la-sintesi-tomistica","target":"la-sintesi-tomistica","line":51}],"metadata":{"type":"source","title":"Somma Teologica — bibliographic/structural entry","address":"c-000038","created":"2026-07-25","updated":"2026-07-25","tags":["#tomismo","#source","#primary-text","#structural-ingest"],"status":"seed","related":["[[San Tommaso d'Aquino]]","[[Tomismo]]"],"source_type":"book","author":"San Tommaso d'Aquino","date_published":"1265/66–1273 (unfinished at Aquinas's death, 7 March 1274); this Italian edition trans. P. Tito S. Centi O.P., online revision P. Angelo Zelio Belloni O.P., 2009","url":"","confidence":"high","key_claims":["This is a structural/bibliographic ingest, not a content read: the file is 5,318 pages (the complete Summa in one PDF), far beyond what can be read in a single ingest pass — this entry records verified structure only, extracted directly from the file's own master index (pp. 1-35), for use as a navigation aid in future targeted deep-ingests.","The verified structure: Prima Pars (I, ~119 qq.), Prima Secundae (I-II, 114 qq., ending at q.114 'Il merito'), Secunda Secundae (II-II, 189 qq., ending at q.189 'L'entrata in religione'), Tertia Pars (III, 90 qq., ending at q.90 'Le parti della penitenza in generale' — confirming Aquinas left the treatise on Penance unfinished at his death), and the Supplementum (compiled posthumously by Reginald of Piperno from Aquinas's earlier Scriptum super Sententiis, per Gilson's bibliography in le-thomisme-gilson)."],"raw_file":".raw/S. Tommaso d'Aquino - Somma Teologica.pdf"},"task_lines":[],"tasks":{},"codeblock_ranges":[]},"smart_blocks:Wiki/sources/somma-teologica-struttura.md#---frontmatter---": {"path":null,"last_embed":{"hash":null},"embeddings":{},"text":null,"length":0,"last_read":{"hash":"u8772n","at":1785014026854},"key":"Wiki/sources/somma-teologica-struttura.md#---frontmatter---","lines":[1,25],"size":1466,"outlinks":[{"title":"San Tommaso d'Aquino","target":"San Tommaso d'Aquino","line":14},{"title":"Tomismo","target":"Tomismo","line":15}],"class_name":"SmartBlock"},
