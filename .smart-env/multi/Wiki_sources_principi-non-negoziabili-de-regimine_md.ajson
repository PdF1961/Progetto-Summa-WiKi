ance for this vault":[58,61],"#Source: De regimine principum ad regem Cypri#Significance for this vault#{1}":[60,61],"#Source: De regimine principum ad regem Cypri#Flagged for follow-up deep ingest":[62,65],"#Source: De regimine principum ad regem Cypri#Flagged for follow-up deep ingest#{1}":[64,65],"#Source: De regimine principum ad regem Cypri#Raw File":[66,69],"#Source: De regimine principum ad regem Cypri#Raw File#{1}":[68,69]},"outlinks":[{"title":"San Tommaso d'Aquino","target":"San Tommaso d'Aquino","line":14},{"title":"Tomismo","target":"Tomismo","line":15},{"title":"god-philosophy-universities","target":"god-philosophy-universities","line":16},{"title":"le-thomisme-gilson","target":"le-thomisme-gilson","line":31},{"title":"le-thomisme-gilson","target":"le-thomisme-gilson","line":33},{"title":"god-philosophy-universities","target":"god-philosophy-universities","line":60}],"metadata":{"type":"source","title":"De regimine principum ad regem Cypri (\"Principi non negoziabili sulla società e sulla politica\")","address":"c-000035","created":"2026-07-25","updated":"2026-07-25","tags":["#tomismo","#source","#primary-text","#political-philosophy"],"status":"developing","related":["[[San Tommaso d'Aquino]]","[[Tomismo]]","[[god-philosophy-universities]]"],"source_type":"book","author":"San Tommaso d'Aquino (Libro I, Libro II capp. 1-4); continuato da Tolomeo da Lucca (rest.)","date_published":"1265-1266 (Aquinas's authentic portion, per Mandonnet); continuation by Ptolemy of Lucca after 1274","url":"","confidence":"high","key_claims":["Monarchy (rule by one) is the best form of government because unity of the ruler best secures the common good of peace, mirroring how nature always governs through a single principle (the heart in the body, reason in the soul, one God ruling the universe).","By the same logic of unity, tyranny (corrupt one-man rule) is the worst regime — worse than oligarchy, worse than democracy — because a unified evil is more effective/destructive than a divided one; tyrants specifically suppress solidarity, virtue, and trust among subjects to prevent organized resistance.","Historical case studies (Rome's shift from kings to consuls to emperors; the Hebrew people's judges-then-kings history) illustrate the real danger on both sides: fear of tyranny driving people to reject good kingship, versus the risk that legitimate kingship degenerates into tyranny."],"raw_file":".raw/S. Tommaso d'Aquino - Principi non Negoziabili sulla Società e sulla Politica.epub"},"task_lines":[],"tasks":{},"codeblock_ranges":[]},"smart_blocks:Wiki/sources/principi-non-negoziabili-de-regimine.md#---frontmatter---": {"path":null,"last_embed":{"hash":"8jipau","at":1785014071426},"embeddings":{"TaylorAI/bge-micro-v2":{"vec":[-0.07025492,0.06138142,0.00367299,-0.0168824,-0.02369603,-0.01059867,0.01072778,0.04835213,0.00796083,0.02096947,-0.04006958,-0.01635359,0.06976028,0.04211562,0.03129776,-0.04064959,-0.00451237,0.03264147,-0.00947074,0.02048416,0.13941553,-0.07132559,-0.04472453,-0.05744791,0.02845324,0.04140299,-0.01724892,-0.03032049,-0.03298269,-0.20633237,-0.00363694,0.00675283,-0.04146734,-0.06948902,0.02622294,0.03472772,-0.03108567,0.02846707,-0.02380269,0.03298708,-0.00502421,0.08521877,-0.01842063,0.02233346,0.0216412,-0.01996312,-0.01044442,0.0266696,-0.0280897,-0.00853723,-0.01558095,0.08187952,-0.00103333,0.01486545,0.01250823,0.00551796,-0.0336635,0.05646506,0.03219987,0.06939232,0.06328699,0.07925235,-0.25337341,0.04792371,0.0626001,0.0652762,-0.02261955,0.0129218,-0.05470719,-0.03193227,-0.00742171,0.03843178,0.06475807,0.00661992,-0.02633458,0.04595372,0.00859082,-0.00025787,-0.03110388,-0.03692157,0.03505664,0.02421378,-0.05593341,0.00876191,-0.00618629,-0.01347151,-0.02444985,0.00459967,0.0330744,-0.02098089,0.01531322,-0.01597505,0.10023803,0.02099628,-0.00923486,0.0249653,-0.05791859,0.02134601,-0.02316934,0.05701323,-0.03879922,0.02036857,0.04834975,0.01596432,0.05763776,0.02008212,0.04349323,-0.13368325,-0.0341