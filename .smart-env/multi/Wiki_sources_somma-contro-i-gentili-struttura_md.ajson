,52],"#Source: Summa contro i Gentili — structural entry#Structure (standard four books, per established Thomistic scholarship — not independently re-verified page-by-page in this pass)#{2}":[53,53],"#Source: Summa contro i Gentili — structural entry#Structure (standard four books, per established Thomistic scholarship — not independently re-verified page-by-page in this pass)#{3}":[54,54],"#Source: Summa contro i Gentili — structural entry#Structure (standard four books, per established Thomistic scholarship — not independently re-verified page-by-page in this pass)#{4}":[55,56],"#Source: Summa contro i Gentili — structural entry#Significance for this vault":[57,60],"#Source: Summa contro i Gentili — structural entry#Significance for this vault#{1}":[59,60],"#Source: Summa contro i Gentili — structural entry#Flagged for follow-up deep ingest":[61,64],"#Source: Summa contro i Gentili — structural entry#Flagged for follow-up deep ingest#{1}":[63,64],"#Source: Summa contro i Gentili — structural entry#Raw File":[65,68],"#Source: Summa contro i Gentili — structural entry#Raw File#{1}":[67,68]},"outlinks":[{"title":"San Tommaso d'Aquino","target":"San Tommaso d'Aquino","line":14},{"title":"Tomismo","target":"Tomismo","line":15},{"title":"le-thomisme-gilson","target":"le-thomisme-gilson","line":16},{"title":"le-thomisme-gilson","target":"le-thomisme-gilson","line":19},{"title":"somma-teologica-struttura","target":"somma-teologica-struttura","line":32},{"title":"la-sintesi-tomistica","target":"la-sintesi-tomistica","line":37},{"title":"le-thomisme-gilson","target":"le-thomisme-gilson","line":37},{"title":"sul-male-de-malo","target":"sul-male-de-malo","line":37},{"title":"god-philosophy-universities","target":"god-philosophy-universities","line":53},{"title":"Il Male come Privazione","target":"Il Male come Privazione","line":54},{"title":"sul-male-de-malo","target":"sul-male-de-malo","line":54},{"title":"la-sintesi-tomistica","target":"la-sintesi-tomistica","line":55},{"title":"la-sintesi-tomistica","target":"la-sintesi-tomistica","line":59},{"title":"le-thomisme-gilson","target":"le-thomisme-gilson","line":59},{"title":"somma-teologica-struttura","target":"somma-teologica-struttura","line":59},{"title":"god-philosophy-universities","target":"god-philosophy-universities","line":63},{"title":"god-philosophy-universities","target":"god-philosophy-universities","line":63},{"title":"le-thomisme-gilson","target":"le-thomisme-gilson","line":63}],"metadata":{"type":"source","title":"Summa contro i Gentili — bibliographic/structural entry","address":"c-000039","created":"2026-07-25","updated":"2026-07-25","tags":["#tomismo","#source","#primary-text","#structural-ingest"],"status":"seed","related":["[[San Tommaso d'Aquino]]","[[Tomismo]]","[[le-thomisme-gilson]]"],"source_type":"book","author":"San Tommaso d'Aquino","date_published":"1259-1264/65 (composition, per Mandonnet/Grabmann, cross-checked in [[le-thomisme-gilson]]); this Italian edition trans. P. Tito S. Centi O.P., UTET Torino, 1975","url":"","confidence":"high","key_claims":["The work's traditional title is not original — Aquinas likely called it Liber de Veritate Catholicae Fidei contra errores infidelium; 'Summa contro i Gentili' is a later scribal shorthand attested in Paris booksellers' lists by c. 1277.","Scholarly opinion is split (Chenu vs. Gauthier, discussed at length in Centi's introduction) on whether the work is deeply conditioned by its historical missionary context or deliberately atemporal/systematic; Gauthier's revisionist philological work discredits several popular legends (composition on scraps of paper, the Louis IX fist-on-the-table anecdote, Mandonnet's serial-publication theory) but the 'commissioned by St. Raymond of Peñafort to aid conversion of Muslims and Jews' tradition, per Peter Marsili's testimony, is not fully resolved.","The work is formally and deliberately theological, not a 'Summa philosophica' as some have relabeled it, despite containing extensive and profound metaphysical speculation — the metaphysics is always in service of theology's task of grounding Christian doctrinal synthesis."],"raw_file":".raw/S. Tommaso d'Aquino. - Somma contro i Gentili [ocr] [1975].pdf"},"task_lines":[],"tasks":{},"codeblock_ranges":[]},"smart_blocks:Wiki/sources/somma-contro-i-gentili-struttura.md#---frontmatter---": {"path":null,"last_embed":{"hash":null},"embeddings":{},"text":null,"length":0,"last_read":{"hash":"10yn4fn","at":1785014026854},"key":"Wiki/sources/somma-contro-i-gentili-struttura.md#---frontmatter---","lines":[1,27],"size":1738,"outlinks":[{"title":"San Tommaso d'Aquino","target":"San Tommaso d'Aquino","line":14},{"title":"Tomismo","target":"Tomismo","line":15},{"title":"le-thomisme-gilson","target":"le-thomisme-gilson","line":16},{"title":"le-thomisme-gilson","target":"le-thomisme-gilson","line":19}],"class_name":"SmartBlock"},
