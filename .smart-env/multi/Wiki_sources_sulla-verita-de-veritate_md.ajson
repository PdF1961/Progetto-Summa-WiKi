":[{"title":"San Tommaso d'Aquino","target":"San Tommaso d'Aquino","line":14},{"title":"Tomismo","target":"Tomismo","line":15},{"title":"la-sintesi-tomistica","target":"la-sintesi-tomistica","line":18},{"title":"le-thomisme-gilson","target":"le-thomisme-gilson","line":18},{"title":"essenza-e-attualita-del-tomismo","target":"essenza-e-attualita-del-tomismo","line":34},{"title":"la-sintesi-tomistica","target":"la-sintesi-tomistica","line":34},{"title":"le-thomisme-gilson","target":"le-thomisme-gilson","line":34},{"title":"somma-contro-i-gentili-struttura","target":"somma-contro-i-gentili-struttura","line":38},{"title":"essenza-e-attualita-del-tomismo","target":"essenza-e-attualita-del-tomismo","line":42},{"title":"la-sintesi-tomistica","target":"la-sintesi-tomistica","line":42},{"title":"essenza-e-attualita-del-tomismo","target":"essenza-e-attualita-del-tomismo","line":46},{"title":"god-philosophy-universities","target":"god-philosophy-universities","line":46},{"title":"god-philosophy-universities","target":"god-philosophy-universities","line":46},{"title":"la-sintesi-tomistica","target":"la-sintesi-tomistica","line":46},{"title":"sul-male-de-malo","target":"sul-male-de-malo","line":46},{"title":"sul-male-de-malo","target":"sul-male-de-malo","line":50}],"metadata":{"type":"source","title":"Quaestiones disputatae de veritate (Sulla Verità) — bibliographic entry","address":"c-000040","created":"2026-07-25","updated":"2026-07-25","tags":["#tomismo","#source","#primary-text","#structural-ingest"],"status":"seed","related":["[[San Tommaso d'Aquino]]","[[Tomismo]]"],"source_type":"book","author":"San Tommaso d'Aquino","date_published":"1256-1259 (composition, per Mandonnet; cross-checked against [[le-thomisme-gilson]] and [[la-sintesi-tomistica]] bibliographies)","url":"","confidence":"medium","key_claims":["This file could not be read at all in this session: it is a pure image scan (1,152 pages, no OCR text layer — pdftotext extracted zero characters) and exceeds the 100MB size limit for direct image viewing. This entry is therefore built entirely from established Thomistic scholarship, not from any text extracted from this specific file.","De Veritate is the disputed question repeatedly cross-cited (as 'De ver.') across every other source in this vault — Garrigou-Lagrange, MacIntyre, and Gilson's bibliographies all reference it, most importantly q.1 for the classic definition of truth as adaequatio rei et intellectus, directly relevant to the truth-vs-pragmatism polemic already documented from essenza-e-attualita-del-tomismo."],"raw_file":".raw/S. Tommaso d'Aquino - Sulla Verità.pdf"},"task_lines":[],"tasks":{},"codeblock_ranges":[]},"smart_blocks:Wiki/sources/sulla-verita-de-veritate.md#---frontmatter---": {"path":null,"last_embed":{"hash":null},"embeddings":{},"text":null,"length":0,"last_read":{"hash":"clqima","at":1785014026854},"key":"Wiki/sources/sulla-verita-de-veritate.md#---frontmatter---","lines":[1,25],"size":1333,"outlinks":[{"title":"San Tommaso d'Aquino","target":"San Tommaso d'Aquino","line":14},{"title":"Tomismo","target":"Tomismo","line":15},{"title":"la-sintesi-tomistica","target":"la-sintesi-tomistica","line":18},{"title":"le-thomisme-gilson","target":"le-thomisme-gilson","line":18}],"class_name":"SmartBlock"},
